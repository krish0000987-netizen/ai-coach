// AI Life Coach schema
// An interconnected digital brain, secure document vault, and 6 specialized AI coaches.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User (authentication) ───────────────────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  totpSecret   String?   // encrypted TOTP secret for 2FA
  totpVerified Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        Item[]
  projects     Project[]
  documents    Document[]
  reminders    Reminder[]
  conversations AICoachConversation[]
  reviews      Review[]
  ownedWorkspaces FamilyWorkspace[]
  memberships  FamilyMember[]
}

// ─── Life Domains (11 Life Categories) ──────────────────────────────────────
model Domain {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String?
  color       String   @default("#71717a")
  accent      String?  // tailwind-ish accent token
  order       Int      @default(0)
  items       Item[]
  projects    Project[]
  createdAt   DateTime @default(now())
}

// ─── Universal Item (Digital Brain node) ───────────────────────────────────
model Item {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // task | note | journal | habit | event | finance | contact | idea | goal | document | bookmark | milestone | routine | symptom | medication | affirmation | vision
  title       String
  content     String?  // markdown / rich text body
  domainId    String?
  domain      Domain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  status      String   @default("active") // inbox | active | done | archived | snoozed
  priority    Int      @default(0) // 0 none, 1 low, 2 medium, 3 high, 4 urgent
  energy      Int      @default(0) // 0 none, 1 low, 2 medium, 3 high

  startDate   DateTime?
  dueDate     DateTime?
  scheduledAt DateTime?
  completedAt DateTime?

  metadata    String?  // JSON string for type-specific fields

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  linksFrom   Link[]   @relation("LinkFrom")
  linksTo     Link[]   @relation("LinkTo")
  tags        TagOnItem[]
  reviewItems ReviewItem[]
  habitLogs   HabitLog[]
  reminders   Reminder[]

  @@index([type])
  @@index([status])
  @@index([userId])
  @@index([domainId])
  @@index([projectId])
  @@index([dueDate])
  @@index([scheduledAt])
}

// ─── Project / Container ────────────────────────────────────────────────────
model Project {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String   @default("#71717a")
  icon        String?
  domainId    String?
  domain      Domain?  @relation(fields: [domainId], references: [id], onDelete: SetNull)
  status      String   @default("active") // active | paused | completed | archived
  progress    Int      @default(0) // 0-100
  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       Item[]

  @@index([status])
  @@index([domainId])
  @@index([userId])
}

// ─── Document Vault ─────────────────────────────────────────────────────────
model Document {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         String    // 1 of 11 life categories
  documentType     String    // passport, id_card, medical_record, etc.
  fileName         String
  fileSize         Int
  mimeType         String
  storagePath      String
  issueDate        DateTime?
  expiryDate       DateTime?
  tags             String?   // JSON string
  notes            String?
  extractedText    String?
  extractionStatus String    @default("pending") // pending | completed | failed | unsupported
  aiSummary        String?
  isSensitive      Boolean   @default(true)
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  reminders        Reminder[]

  @@index([userId])
  @@index([category])
  @@index([documentType])
  @@index([expiryDate])
}

// ─── AI Coach Conversation & Messages ──────────────────────────────────────
model AICoachConversation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachType   String           // health | finance | career | life | hobby | predictive | unified
  title       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  messages    AICoachMessage[]

  @@index([userId])
  @@index([coachType])
}

model AICoachMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   AICoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String              // user | assistant | system
  content        String
  metadata       String?             // JSON string
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

// ─── Predictive Reminders & Alerts ──────────────────────────────────────────
model Reminder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String?
  type        String    @default("expiry") // expiry | renewal | follow_up | health_check | goal_due | predictive
  remindAt    DateTime
  dueDate     DateTime?
  status      String    @default("pending") // pending | snoozed | completed | dismissed
  sent        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([remindAt])
  @@index([status])
}

// ─── Family Workspaces & Sharing ────────────────────────────────────────────
model FamilyWorkspace {
  id          String                 @id @default(cuid())
  name        String
  ownerId     String
  owner       User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  members     FamilyMember[]
  resources   FamilySharedResource[]

  @@index([ownerId])
}

model FamilyMember {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   FamilyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  role        String          @default("viewer") // owner | admin | contributor | viewer
  status      String          @default("pending") // pending | active | revoked
  inviteToken String?         @unique
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([workspaceId])
  @@index([userId])
}

model FamilySharedResource {
  id             String          @id @default(cuid())
  workspaceId    String
  workspace      FamilyWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resourceType   String          // document | item | milestone | calendar
  resourceId     String
  sharedByUserId String
  canEdit        Boolean         @default(false)
  createdAt      DateTime        @default(now())

  @@index([workspaceId])
}

// ─── Bi-directional Link ─────────────────────────────────────────────────────
model Link {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  type      String   @default("related") // related | blocks | parent | subtask | references | depends-on
  note      String?
  createdAt DateTime @default(now())

  from      Item     @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Item     @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
}

// ─── Tags ────────────────────────────────────────────────────────────────────
model Tag {
  id        String      @id @default(cuid())
  name      String      @unique
  color     String      @default("#71717a")
  items     TagOnItem[]
  createdAt DateTime    @default(now())
}

model TagOnItem {
  itemId String
  tagId  String
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
}

// ─── Habit Logs ──────────────────────────────────────────────────────────────
model HabitLog {
  id        String   @id @default(cuid())
  itemId    String
  date      DateTime
  value     Int      @default(1)
  note      String?
  createdAt DateTime @default(now())

  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, date])
  @@index([itemId, date])
}

// ─── Reviews & Reflections ───────────────────────────────────────────────────
model Review {
  id         String       @id @default(cuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String       // daily | weekly | monthly
  date       DateTime
  status     String       @default("completed") // pending | in_progress | completed
  weekStart  DateTime?
  weekEnd    DateTime?

  wins       String?
  challenges String?
  learnings  String?
  priorities String?      // JSON array string
  gratitude  String?
  mood       Int?
  energy     Int?
  notes      String?

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  items      ReviewItem[]

  @@index([type, date])
  @@index([userId])
}

model ReviewItem {
  reviewId String
  itemId   String
  note     String?
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([reviewId, itemId])
}

// ─── Settings (key-value) ────────────────────────────────────────────────────
model Setting {
  id    String @id
  value String
}
