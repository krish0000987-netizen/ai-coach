# AI Life Coach — Environment Variables Configuration

# ─── Supabase PostgreSQL Database ─────────────────────────────────────────────
# Transaction / Session connection pooler URL (Port 5432 or 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Direct PostgreSQL database connection URL (Used for schema migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ─── Application Authentication & Sessions ─────────────────────────────────────
SESSION_SECRET="your-secure-session-secret-change-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Supabase API & Private Storage Vault ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# ─── OpenRouter AI Coach Integration ──────────────────────────────────────────
# Leave OPENROUTER_API_KEY empty to run in Free Demo Mode with local verified insights
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
